{
    "name": "mliviu79/laravel-langfuse-prism",
    "description": "Seamless integration of Langfuse observability for Laravel and Laravel Prism.",
    "type": "library",
    "license": "MIT",
    "keywords": ["observability", "tracing", "ai", "llm", "laravel", "prism", "langfuse", "opentelemetry"],
    "authors": [
        {
            "name": "Hanan",
            "email": "hanan@showdigs.com",
            "role": "Original Creator"
        },
        {
            "name": "Liviu Muresan",
            "email": "muresan_liviu@yahoo.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "ext-json": "*",
        "illuminate/container": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "open-telemetry/exporter-otlp": "^1.3",
        "open-telemetry/sdk": "^1.9",
        "php-http/guzzle7-adapter": "^1.1",
        "psr/log": "^1.1|^2.0|^3.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "keepsuit/laravel-opentelemetry": "^1.15",
        "laravel/pint": "^1.10",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpstan/phpstan": "^1.10|^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "prism-php/prism": "^0.99.11"
    },
    "autoload": {
        "psr-4": {
            "Langfuse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Langfuse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Langfuse\\Integration\\Laravel\\LangfuseServiceProvider",
                "Langfuse\\Integration\\Prism\\PrismLangfuseServiceProvider"
            ],
            "aliases": {
                "Langfuse": "Langfuse\\Integration\\Laravel\\Facades\\Langfuse"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse",
        "format": "pint",
        "check": [
            "@analyse",
            "@test"
        ]
    }
}
